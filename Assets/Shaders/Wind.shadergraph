{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "06391977baf54f4a8a24b11ae0de919c",
    "m_Title": "Why divide by 100?",
    "m_Content": "This is to help offset using really small numbers like 0.01 or 0.1 all the time for \"Strength\"",
